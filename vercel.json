{
  "crons": [
    {
      "path": "/api/sync",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/internal/estudio-anuncios/worker",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/internal/agentes/worker",
      "schedule": "* * * * *"
    }
  ],
  "functions": {
    "app/api/**": {
      "maxDuration": 60
    },
    "app/api/internal/estudio-anuncios/worker/route.ts": {
      "maxDuration": 300
    },
    "app/api/internal/agentes/worker/route.ts": {
      "maxDuration": 300
    }
  }
}

# ── Mercado Livre OAuth ────────────────────────────────────────────────────────
# Crie seu app em: https://developers.mercadolibre.com.br/devcenter
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Em produção: https://seu-dominio.vercel.app/api/auth/mercadolivre/callback
# Em dev local: use ngrok e aponte para http://localhost:3001
ML_REDIRECT_URI=

# ── Supabase ───────────────────────────────────────────────────────────────────
# Em: https://app.supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Feature flag: arquitetura nova de sincronização — adicionado 2026-07-13 ────
# Ver docs/DECISIONS.md. FALSE (padrão) = produção usa exatamente o fluxo
# antigo (sync inline via ?sync=1 nas rotas de leitura, botão Sincronizar
# síncrono). TRUE = usa sync_jobs + worker + polling. NÃO ativar em produção
# até existir um processador permanente de jobs (scripts/sync-worker.mjs
# hoje é um processo manual local, não roda no Vercel) — decisão explícita,
# ver docs/ROADMAP.md. Precisa do prefixo NEXT_PUBLIC_ porque
# app/(app)/vendas/page.tsx (client component) lê este valor para decidir
# qual fluxo o botão Sincronizar usa.
NEXT_PUBLIC_ENABLE_ASYNC_SYNC_JOBS=false

# ── Worker de sincronização (sync_jobs) — adicionado 2026-07-11 ────────────────
# Ver docs/DECISIONS.md (redesenho do botão Sincronizar). Usadas SOMENTE por
# scripts/sync-worker.mjs e app/api/internal/sync/executar — nunca em código
# de rota pública nem enviadas ao frontend/browser. Só têm efeito quando
# NEXT_PUBLIC_ENABLE_ASYNC_SYNC_JOBS=true.

# Supabase > Settings > API > service_role (secreta — ignora RLS). NUNCA usar
# em nenhuma rota chamada pelo browser, só no processo do worker.
SUPABASE_SERVICE_ROLE_KEY=

# String aleatória qualquer (ex: gerada com `openssl rand -hex 32`). Precisa
# ser IDÊNTICA entre o worker e app/api/internal/sync/executar — é o que
# autoriza o worker a chamar essa rota interna.
SYNC_WORKER_INTERNAL_SECRET=

# Minutos sem heartbeat até um job "rodando" ser considerado abandonado e
# reenfileirado/marcado como erro. Default se ausente: 10.
SYNC_JOB_STALE_MINUTES=10

# Opcional — base URL que o worker chama para executar o sync (Next.js
# precisa estar rodando nesse endereço). Default se ausente: http://127.0.0.1:3000
SYNC_WORKER_BASE_URL=

# ── Worker do Estúdio de Anúncios (Central de IA) — adicionado 2026-08-04 ──────
# Segredo usado pelo worker (scripts/estudio-anuncios-worker.mjs) para chamar
# a rota interna app/api/internal/estudio-anuncios/executar. Precisa ser forte
# e diferente em cada ambiente (ex: gerado com `openssl rand -hex 32`). NUNCA
# usar prefixo NEXT_PUBLIC_ — não deve chegar ao browser. Valor real não deve
# ser commitado.
ESTUDIO_ANUNCIOS_WORKER_INTERNAL_SECRET=

# Timeout (ms) que o worker aguarda pela resposta da rota interna acima —
# adicionado 2026-08-06 pra corrigir falso-negativo (a rota terminava o job
# com sucesso DEPOIS que o worker já tinha desistido de esperar e reportado
# falha). Server-only, NUNCA NEXT_PUBLIC_. Ausente = usa o padrão seguro
# 120000 (120s). Presente mas inválido (não-inteiro, <= 0, ou acima do teto
# 600000) falha explicitamente — nunca cai de volta pro antigo valor fixo de
# 30000 silenciosamente. Ver lerTimeoutHttpWorker() em
# scripts/estudio-anuncios-worker.mjs. Recomendado: 120000 (valor real fica
# só no .env.local — deixado vazio aqui de propósito).
ESTUDIO_ANUNCIOS_WORKER_HTTP_TIMEOUT_MS=

# ── Worker de Agentes (CDS AI Office) — adicionado 2026-08-25 ─────────────────
# Segredo usado pelo worker de agentes (scripts/agentes-worker.mjs) para chamar
# a rota interna app/api/internal/agentes/executar.
#
# DELIBERADAMENTE DIFERENTE de ESTUDIO_ANUNCIOS_WORKER_INTERNAL_SECRET: os dois
# motores são isolados um do outro, e reaproveitar o segredo faria com que o
# comprometimento de um alcançasse o outro. Precisa ser forte e diferente em
# cada ambiente (ex: gerado com `openssl rand -hex 32`). NUNCA usar prefixo
# NEXT_PUBLIC_ — não deve chegar ao browser. Ausente = a rota interna recusa
# tudo (fail-closed). Valor real não deve ser commitado.
AGENTES_WORKER_INTERNAL_SECRET=

# URL base que o worker de agentes usa para alcançar a aplicação. Ausente = usa
# o padrão http://localhost:3000 (desenvolvimento). Não é segredo.
AGENTES_WORKER_BASE_URL=http://localhost:3000

# Timeout (ms) que o worker de agentes aguarda pela resposta da rota interna.
# Ausente = padrão seguro 60000. Presente mas inválido (não-numérico, NaN,
# Infinity, <= 0 ou acima do teto 600000) = cai no padrão COM AVISO, nunca
# silenciosamente — `Number("abc")` é NaN, e um AbortController com timeout NaN
# aborta IMEDIATAMENTE, o que faria o worker reportar falha de rede inexistente.
# Ver lerTimeoutHttp() em scripts/agentes-worker.mjs. Não é segredo.
AGENTES_WORKER_HTTP_TIMEOUT_MS=60000

# ── Google Gemini (Central de IA — analise_visual) — adicionado 2026-08-09 ─────
# Primeira integração real de IA do Estúdio de Anúncios. Usadas SOMENTE em
# lib/ai-gateway/provedores/google.ts, lib/estudio-anuncios/analise-visual.ts e
# lib/ai-gateway/roteamento.ts — nunca em código enviado ao browser. NUNCA usar
# prefixo NEXT_PUBLIC_. Valor real não deve ser commitado.

# https://aistudio.google.com/apikey — chave de servidor, nunca logada.
GOOGLE_AI_API_KEY=

# Nome do modelo Gemini a usar na etapa analise_visual. Lido em tempo de
# execução — nunca fixado no código (obterModeloVisual() em
# lib/ai-gateway/provedores/google.ts é o único ponto que lê esta
# variável). Obrigatório quando GOOGLE_AI_ENABLED=true (ausente, vazio ou
# só com espaços falha como erro "auth" ao chamar o Gemini — sem
# fallback silencioso). DESVIO DELIBERADO da convenção do resto deste
# arquivo (as demais variáveis ficam vazias por padrão): esta vem
# preenchida com o modelo estável recomendado por decisão explícita
# (2026-08-09) — ajuste se um modelo mais novo for adotado.
GOOGLE_AI_MODEL_VISUAL=gemini-3.6-flash

# Liga/desliga a chamada real ao Gemini para a etapa analise_visual. Ausente ou
# qualquer valor diferente de "true" (inclui vazio) = analise_visual continua
# fake, com segurança, mesmo que as outras variáveis estejam preenchidas. Uma
# vez "true", GOOGLE_AI_API_KEY ausente falha como erro "auth" — nunca cai de
# volta para fake silenciosamente. Não controla geracao_conteudo — ver
# GOOGLE_AI_GERACAO_CONTEUDO_ENABLED abaixo (flag própria, por desenho).
GOOGLE_AI_ENABLED=false

# Nome do modelo Gemini a usar na etapa geracao_conteudo. Variável própria,
# nunca reaproveita GOOGLE_AI_MODEL_VISUAL (obterModeloConteudo() em
# lib/ai-gateway/provedores/google.ts é o único ponto que lê esta variável —
# mesma invariante já documentada para GOOGLE_AI_MODEL_VISUAL). Obrigatório
# quando GOOGLE_AI_GERACAO_CONTEUDO_ENABLED=true (ausente, vazio ou só com
# espaços falha como erro "auth" — sem fallback silencioso, nunca cai de volta
# para GOOGLE_AI_MODEL_VISUAL). Deixada vazia por padrão nesta tarefa (ainda
# não há chamada real ao Gemini nesta etapa) — preencher antes de habilitar.
GOOGLE_AI_MODEL_CONTEUDO=

# Liga/desliga a chamada real ao Gemini para a etapa geracao_conteudo. Flag
# própria, independente de GOOGLE_AI_ENABLED (que só controla analise_visual)
# — permite habilitar as duas etapas em momentos diferentes, sem redefinir o
# escopo já documentado da flag existente. Ausente ou qualquer valor diferente
# de "true" (inclui vazio) = geracao_conteudo continua no caminho fake
# genérico, com segurança. Nesta tarefa, permanece false — nenhuma chamada
# real ao Gemini foi feita em geracao_conteudo ainda.
GOOGLE_AI_GERACAO_CONTEUDO_ENABLED=false

# Nome do modelo Gemini a usar na etapa adaptacao_marketplace. Variável própria,
# nunca reaproveita GOOGLE_AI_MODEL_CONTEUDO (obterModeloAdaptacaoMarketplace()
# em lib/ai-gateway/provedores/google.ts é o único ponto que lê esta variável —
# mesma invariante das outras duas). Obrigatório quando
# GOOGLE_AI_ADAPTACAO_MARKETPLACE_ENABLED=true (ausente, vazio ou só com espaços
# falha como erro "auth" — sem fallback silencioso). Mesmo que o valor inicial
# seja igual ao de outra etapa, a variável é separada de propósito: permite
# trocar o modelo de uma etapa sem afetar as demais.
GOOGLE_AI_MODEL_ADAPTACAO_MARKETPLACE=

# Liga/desliga a chamada real ao Gemini para a etapa adaptacao_marketplace.
# Flag própria, independente das flags das outras etapas. Ausente ou qualquer
# valor diferente de "true" (inclui vazio) = adaptacao_marketplace continua no
# caminho fake genérico, com segurança.
GOOGLE_AI_ADAPTACAO_MARKETPLACE_ENABLED=false

# Nome do modelo Gemini a usar na etapa geracao_prompts_imagem. Variável
# própria, nunca reaproveita GOOGLE_AI_MODEL_CONTEUDO nem
# GOOGLE_AI_MODEL_ADAPTACAO_MARKETPLACE (obterModeloPromptsImagem() em
# lib/ai-gateway/provedores/google.ts é o único ponto que lê esta variável).
# ATENÇÃO: é um modelo de TEXTO. Esta etapa planeja prompts, não gera imagem —
# nenhum modelo de imagem é envolvido. Obrigatório quando
# GOOGLE_AI_PROMPTS_IMAGEM_ENABLED=true (ausente, vazio ou só com espaços falha
# como erro "auth", sem fallback silencioso).
GOOGLE_AI_MODEL_PROMPTS_IMAGEM=

# Liga/desliga a chamada real ao Gemini para a etapa geracao_prompts_imagem.
# Flag própria, independente das flags das outras etapas. Ausente ou qualquer
# valor diferente de "true" (inclui vazio) = geracao_prompts_imagem continua no
# caminho fake genérico, com segurança.
GOOGLE_AI_PROMPTS_IMAGEM_ENABLED=false

# Nome do modelo de IMAGEM usado na etapa geracao_imagem. Variável própria,
# nunca reaproveita nenhum dos quatro modelos de TEXTO acima
# (obterModeloImagem() em lib/ai-gateway/provedores/google-imagem.ts é o único
# ponto que lê esta variável). Apontar um modelo de texto aqui produziria erro
# obscuro no provedor em vez de erro de configuração. Obrigatório quando
# GOOGLE_AI_IMAGEM_ENABLED=true (ausente/vazio falha como erro "auth").
# Escolhido com o usuário em 2026-08-16 entre os modelos REALMENTE disponíveis
# para a chave do projeto: a família Gemini image ("Nano Banana") aceita foto de
# referência, o que preserva a identidade física do produto; Imagen 4 nesta
# chave é só texto→imagem.
GOOGLE_AI_MODEL_IMAGEM=

# Liga/desliga a geração real de imagem. Flag própria, independente das demais.
# Ausente ou qualquer valor diferente de "true" (inclui vazio) = geracao_imagem
# continua no caminho fake genérico, sem tocar em Storage e sem custo.
GOOGLE_AI_IMAGEM_ENABLED=false

# Timeout POR IMAGEM, em ms. Não reaproveita os 30s das chamadas de texto —
# geração de imagem é outra ordem de grandeza. Ausente = 90000. Teto = 300000.
# ATENÇÃO: um job gera N imagens em sequência, então o pior caso do job é
# N × este valor. ESTUDIO_ANUNCIOS_WORKER_HTTP_TIMEOUT_MS precisa continuar
# maior que isso, senão o Worker desiste enquanto a rota ainda persiste.
GOOGLE_AI_IMAGEM_TIMEOUT_MS=90000

# Máximo de fotos do produto enviadas ao Gemini por análise (principal primeiro,
# depois por ordem). Inteiro entre 1 e 10. Ausente = usa o padrão seguro 3.
# Presente mas inválido falha explicitamente (nunca ignorado). Recomendado: 3.
GOOGLE_AI_MAX_IMAGES=3

# Orçamento de bytes (soma dos arquivos reais) por análise — fotos que
# excederiam esse total simplesmente não entram (registrado em
# metadadosAnalise.analiseParcial, nunca escondido). Inteiro positivo, nunca
# acima do teto seguro para envio inline (~18MB). Ausente = usa o padrão seguro
# 12582912 (12MB). Presente mas inválido falha explicitamente. Recomendado:
# 12582912.
GOOGLE_AI_MAX_BYTES=12582912

# ── Anthropic (Central de IA — revisao_claude) — adicionado 2026-08-14 ────────
# Segundo provedor real do modulo. Usadas SOMENTE em
# lib/ai-gateway/provedores/anthropic.ts e lib/ai-gateway/roteamento.ts — nunca
# em codigo enviado ao browser. NUNCA usar prefixo NEXT_PUBLIC_.

# https://platform.claude.com — chave de servidor, nunca logada.
ANTHROPIC_API_KEY=

# Modelo Claude usado na etapa revisao_claude. Variavel propria, nunca
# reaproveita modelo de outra etapa (obterModeloRevisao() em
# provedores/anthropic.ts e o unico ponto que le esta variavel). Obrigatoria
# quando ANTHROPIC_REVISAO_ENABLED=true — ausente/vazia falha como erro "auth",
# sem fallback silencioso. O nome precisa constar em
# TABELA_PRECOS_USD_POR_MILHAO_TOKENS (lib/ai-gateway/custos.ts), senao o custo
# e gravado como 0 com console.warn.
ANTHROPIC_MODEL_REVISAO=claude-opus-5

# Liga/desliga a chamada real a Anthropic na etapa revisao_claude. Flag propria,
# independente das flags do Google. Ausente ou qualquer valor diferente de
# "true" (inclui vazio) = revisao_claude continua no caminho fake generico.
ANTHROPIC_REVISAO_ENABLED=false

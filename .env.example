# ── Mercado Livre OAuth ────────────────────────────────────────────────────────
# Crie seu app em: https://developers.mercadolibre.com.br/devcenter
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Em produção: https://seu-dominio.vercel.app/api/auth/mercadolivre/callback
# Em dev local: use ngrok e aponte para http://localhost:3001
ML_REDIRECT_URI=

# ── Supabase ───────────────────────────────────────────────────────────────────
# Em: https://app.supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Feature flag: arquitetura nova de sincronização — adicionado 2026-07-13 ────
# Ver docs/DECISIONS.md. FALSE (padrão) = produção usa exatamente o fluxo
# antigo (sync inline via ?sync=1 nas rotas de leitura, botão Sincronizar
# síncrono). TRUE = usa sync_jobs + worker + polling. NÃO ativar em produção
# até existir um processador permanente de jobs (scripts/sync-worker.mjs
# hoje é um processo manual local, não roda no Vercel) — decisão explícita,
# ver docs/ROADMAP.md. Precisa do prefixo NEXT_PUBLIC_ porque
# app/(app)/vendas/page.tsx (client component) lê este valor para decidir
# qual fluxo o botão Sincronizar usa.
NEXT_PUBLIC_ENABLE_ASYNC_SYNC_JOBS=false

# ── Worker de sincronização (sync_jobs) — adicionado 2026-07-11 ────────────────
# Ver docs/DECISIONS.md (redesenho do botão Sincronizar). Usadas SOMENTE por
# scripts/sync-worker.mjs e app/api/internal/sync/executar — nunca em código
# de rota pública nem enviadas ao frontend/browser. Só têm efeito quando
# NEXT_PUBLIC_ENABLE_ASYNC_SYNC_JOBS=true.

# Supabase > Settings > API > service_role (secreta — ignora RLS). NUNCA usar
# em nenhuma rota chamada pelo browser, só no processo do worker.
SUPABASE_SERVICE_ROLE_KEY=

# String aleatória qualquer (ex: gerada com `openssl rand -hex 32`). Precisa
# ser IDÊNTICA entre o worker e app/api/internal/sync/executar — é o que
# autoriza o worker a chamar essa rota interna.
SYNC_WORKER_INTERNAL_SECRET=

# Minutos sem heartbeat até um job "rodando" ser considerado abandonado e
# reenfileirado/marcado como erro. Default se ausente: 10.
SYNC_JOB_STALE_MINUTES=10

# Opcional — base URL que o worker chama para executar o sync (Next.js
# precisa estar rodando nesse endereço). Default se ausente: http://127.0.0.1:3000
SYNC_WORKER_BASE_URL=
